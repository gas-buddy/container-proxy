{
  "name": "@gasbuddy/container-proxy",
  "version": "3.1.0",
  "description": "A reverse proxy that allows dynamic endpoint registration",
  "main": "build/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src/",
    "start": "node build/server.js",
    "build-docker": "docker build -t gasbuddy/container-proxy .",
    "publish-docker": "docker push gasbuddy/container-proxy"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "proxy",
    "docker",
    "microservice",
    "gasbuddy"
  ],
  "author": "Developers <developers@gasbuddy.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.17.1",
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^25.6.0",
    "eslint": "^8.56.0",
    "eslint-config-gasbuddy": "^7",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@3.6.4"
}
